FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /widget-service ./cmd/widget-service

FROM gcr.io/distroless/static-debian12
COPY --from=builder /widget-service /
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/widget-service"]
